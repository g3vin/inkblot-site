---
/**
 * Base — every page's document: head, skip link, header, the page, and the footer
 * (which opens with the closing "Write." and download).
 */
import '../styles/tokens.css'
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { SITE } from '../data/site'

interface Props {
  title?: string
  description?: string
  /** `over` floats a text-only header over a picture hero. */
  header?: 'over' | 'solid'
  /** Preload the hero poster, so the first picture paints as early as the text. */
  preloadImage?: { src: string; srcset?: string }
}

const { title = SITE.title, description = SITE.description, header = 'solid', preloadImage } = Astro.props
const canonical = new URL(Astro.url.pathname, SITE.url).href
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content={SITE.themeColor} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={SITE.tagline} />
    <meta property="og:url" content={canonical} />
    {SITE.ogImage && <meta property="og:image" content={new URL(SITE.ogImage, SITE.url).href} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/inter-opsz.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/literata-400.woff2" as="font" type="font/woff2" crossorigin />
    {preloadImage && <link rel="preload" as="image" href={preloadImage.src} imagesrcset={preloadImage.srcset} imagesizes="100vw" fetchpriority="high" />}
    <script is:inline>document.documentElement.classList.add('js')</script>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: SITE.name,
      applicationCategory: 'Writing',
      operatingSystem: 'macOS, Windows, Linux, iOS, iPadOS, Android, ChromeOS',
      isAccessibleForFree: true,
      license: SITE.licence.url,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    })} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header variant={header} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>import '../scripts/device'</script>
    <script is:inline>
      // The bounce colour: the top edge's in the top half of the page, the footer's below.
      (() => {
        const root = document.documentElement
        const set = () => root.classList.toggle('at-foot', scrollY * 2 > root.scrollHeight - innerHeight)
        addEventListener('scroll', set, { passive: true }); addEventListener('resize', set); set()
      })()
    </script>
  </body>
</html>
