---
/**
 * HandRule — a rule drawn by hand, like the Horizon's ground: a few slow waves, smoothed
 * through the midpoints. Drawn in pixels, wider than any screen, and cropped to its box,
 * so the wobble looks the same on a phone and a desktop. Each `seed` shifts the waves so
 * no two rules on a page are alike.
 *
 * It sits across the top edge of its parent (which must be positioned), centred on where
 * a border-top would be, inset by --rule-inset. With `wrap` it brings its own zero-height
 * .wrap, so at the top of a full-bleed section it spans the content column, not the
 * screen. Colour and weight come from --rule-color and --rule-width.
 */
interface Props { seed?: number; wrap?: boolean; class?: string }
const { seed = 0, wrap = false, class: cls } = Astro.props

const W = 3000, N = 300
// Golden-ratio steps spread the seeds evenly, so neighbouring seeds still differ.
const f = (k: number) => ((seed * 0.618 + k * 0.382) % 1)
// Long, lazy swells only, like a pen drawn steadily across a page; no fast jitter.
const wobble = (x: number) =>
  (2.0 + 0.6 * f(1)) * Math.sin(x / (110 + 40 * f(2)) + 6.28 * f(3)) +
  (1.3 + 0.5 * f(4)) * Math.sin(x / (30 + 10 * f(5)) + 6.28 * f(6)) +
  (0.45 + 0.2 * f(7)) * Math.sin(x / (14 + 4 * f(8)) + 6.28 * f(9))
const pts = Array.from({ length: N + 1 }, (_, i) => [(i * W) / N, 8 + wobble((i * W) / N)])
const d = pts.slice(1, -1).reduce(
  (d, [x, y], i) => d + `Q${x.toFixed(1)} ${y.toFixed(2)} ${((x + pts[i + 2][0]) / 2).toFixed(1)} ${((y + pts[i + 2][1]) / 2).toFixed(2)}`,
  `M0 ${pts[0][1].toFixed(2)}`,
) + `L${W} ${pts[N][1].toFixed(2)}`
---
{wrap
  ? <div class="wrap hand-rule__wrap"><svg class:list={['hand-rule', cls]} viewBox={`0 0 ${W} 16`} preserveAspectRatio="xMinYMid slice" aria-hidden="true" focusable="false"><path d={d} /></svg></div>
  : <svg class:list={['hand-rule', cls]} viewBox={`0 0 ${W} 16`} preserveAspectRatio="xMinYMid slice" aria-hidden="true" focusable="false"><path d={d} /></svg>}

<style>
  .hand-rule {
    position: absolute; top: -8px; left: var(--rule-inset, 0px);
    width: calc(100% - 2 * var(--rule-inset, 0px)); height: 16px; pointer-events: none;
  }
  .hand-rule__wrap { position: absolute; top: 0; left: 0; right: 0; height: 0; --rule-inset: var(--gutter); }
  .hand-rule path {
    fill: none; stroke: var(--rule-color, currentColor); stroke-width: var(--rule-width, 2);
    stroke-linecap: round; vector-effect: non-scaling-stroke;
  }
</style>
