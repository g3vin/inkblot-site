---
/**
 * BookSection — "Then it becomes a book.", and then a poetry collection, a screenplay
 * and an ebook. The section pins for a few screens. The headline keeps "Then it becomes"
 * and swaps the rest, with a line and three facts for each form, while a model of each
 * form turns in on the right and opens: the 6 × 9 book onto its chapter, a chapbook onto
 * two poems, a bradded script past its title page, an e-reader out of sleep. Last, the
 * headline becomes "whatever you wrote." and the four gather in a row.
 *
 * Every model is CSS 3D: a box of cover, spine, page edges and back, with a cover that
 * swings open on the spine (`.tm`). Its resting state is the row of four, closed, with
 * the last headline, so with no script or under reduced motion the reader sees them all.
 */
interface Poem { title: string; folio: number; stanzas: string[][] }
interface Props {
  lead: string
  forms: { id: string; name: string; line: string; facts: string[] }[]
  note: string
  sample: {
    title: string; author: string; coverTag: string
    chapterLabel: string; chapterTitle: string; verso: string[]; recto: string[]
  }
  poems: { title: string; author: string; left: Poem; right: Poem }
  script: { title: string; author: string; contact: string[]; page: [string, string][] }
  ebook: { progress: string; left: string }
}
const { lead, forms, note, sample, poems, script, ebook } = Astro.props
const [first, ...rest] = sample.recto
const last = forms.length - 1
const names = forms.slice(0, last).map((f) => f.name.replace(/\.$/, ''))
const spoken = `${lead} ${names.slice(0, -1).join(', ')} or ${names[names.length - 1]}: ${forms[last].name}`
const state = (i: number) => (i === last ? 'is-on' : i < last ? 'is-past' : '')
---
<section class="book" id="book" aria-labelledby="book-title">
  <div class="book__stage">
    <div class="wrap book__grid">
      <div class="stack book__words">
        <h2 class="display book__title" id="book-title">
          <span class="visually-hidden">{spoken}</span>
          <span aria-hidden="true">
            <span class="book__lead">{lead}</span>
            <span class="swap">{forms.map((f, i) => <span class={`swap__item ${state(i)}`}>{f.name}</span>)}</span>
          </span>
        </h2>
        <div class="swap book__line">
          {forms.map((f, i) => <p class={`swap__item ${state(i)}`}>{f.line}</p>)}
        </div>
        <div class="swap">
          {forms.map((f, i) => <ul class={`swap__item facts meta ${state(i)}`}>{f.facts.map((x) => <li>{x}</li>)}</ul>)}
        </div>
      </div>

      <div class="book__scene" role="img" aria-label={`Sample pages from each form: a book, ${sample.title}, open at a chapter; a chapbook of poems, ${poems.title}; a screenplay, ${script.title}, at page one; and the book again on an e-reader`}>
        <!-- The book -->
        <div class="form form--book">
          <div class="form__shadow"></div>
          <div class="model">
            <div class="tm tm--back"></div>
            <div class="tm tm--edge tm--fore"></div>
            <div class="tm tm--edge tm--head"></div>
            <div class="tm tm--edge tm--tail"></div>
            <div class="tm tm--spine"><span>{sample.title}</span><span class="tm__spine-by">{sample.author}</span></div>
            <div class="tm tm--top page page--recto">
              <p class="page__chap">{sample.chapterLabel}</p>
              <p class="page__title">{sample.chapterTitle}</p>
              <p class="page__text"><span class="page__drop">{first[0]}</span>{first.slice(1)}</p>
              {rest.map((p) => <p class="page__text">{p}</p>)}
              <span class="page__folio">13</span>
            </div>
            <div class="tm tm--cover">
              <div class="face cover">
                <p class="cover__title">{sample.title}</p>
                <p class="cover__by">{sample.author}</p>
                <span class="cover__tag meta">{sample.coverTag}</span>
              </div>
              <div class="face face--back page page--verso">
                <p class="page__head">{sample.title}</p>
                {sample.verso.map((p) => <p class="page__text">{p}</p>)}
                <span class="page__folio">12</span>
              </div>
            </div>
          </div>
        </div>

        <!-- The poetry collection: a saddle-stitched chapbook -->
        <div class="form form--poetry">
          <div class="form__shadow"></div>
          <div class="model">
            <div class="tm tm--back"></div>
            <div class="tm tm--edge tm--fore"></div>
            <div class="tm tm--edge tm--head"></div>
            <div class="tm tm--edge tm--tail"></div>
            <div class="tm tm--spine"></div>
            <div class="tm tm--top page page--recto poem">
              <p class="poem__title">{poems.right.title}</p>
              {poems.right.stanzas.map((s) => <p class="poem__stanza">{s.map((l) => <span>{l}</span>)}</p>)}
              <span class="poem__folio">{poems.right.folio}</span>
            </div>
            <div class="tm tm--cover">
              <div class="face cover">
                <p class="cover__title">{poems.title}</p>
                <p class="cover__kind">Poems</p>
                <p class="cover__by">{poems.author}</p>
              </div>
              <div class="face face--back page page--verso poem">
                <p class="poem__title">{poems.left.title}</p>
                {poems.left.stanzas.map((s) => <p class="poem__stanza">{s.map((l) => <span>{l}</span>)}</p>)}
                <span class="poem__folio">{poems.left.folio}</span>
              </div>
            </div>
          </div>
        </div>

        <!-- The screenplay: US Letter, three holes, two brass brads -->
        <div class="form form--script">
          <div class="form__shadow"></div>
          <div class="model">
            <div class="tm tm--back"></div>
            <div class="tm tm--edge tm--fore"></div>
            <div class="tm tm--edge tm--head"></div>
            <div class="tm tm--edge tm--tail"></div>
            <div class="tm tm--spine tm--edge"></div>
            <div class="tm tm--top sp sp--page">
              <span class="sp__hole"></span><span class="sp__hole"></span><span class="sp__hole"></span>
              {script.page.map(([kind, text]) => <p class={`sp__${kind}`}>{text}</p>)}
            </div>
            <div class="tm tm--cover">
              <div class="face sp sp--title">
                <span class="sp__brad"></span><span class="sp__hole"></span><span class="sp__brad"></span>
                <div class="sp__titleblock">
                  <p>{script.title}</p>
                  <p>Written by</p>
                  <p>{script.author}</p>
                </div>
                <div class="sp__contact">{script.contact.map((c) => <p>{c}</p>)}</div>
              </div>
              <div class="face face--back sp sp--behind"></div>
            </div>
          </div>
        </div>

        <!-- The ebook: an e-reader that wakes from its cover -->
        <div class="form form--ebook">
          <div class="form__shadow"></div>
          <div class="model">
            <div class="dv dv--back"></div>
            <div class="dv dv--side dv--l"></div>
            <div class="dv dv--side dv--r"></div>
            <div class="dv dv--end dv--t"></div>
            <div class="dv dv--end dv--b"></div>
            <div class="dv dv--front">
              <div class="dv__screen">
                <div class="scr scr--read">
                  <p class="scr__chap">{sample.chapterLabel}</p>
                  <p class="scr__title">{sample.chapterTitle}</p>
                  {sample.recto.map((p) => <p class="scr__text">{p}</p>)}
                </div>
                <p class="scr__foot"><span>{ebook.left}</span><span>{ebook.progress}</span></p>
                <div class="scr scr--sleep">
                  <p class="cover__title">{sample.title}</p>
                  <p class="cover__by">{sample.author}</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <p class="meta book__note">{note}</p>
  </div>
</section>

<style>
  .book { background: var(--bg-sunk); position: relative; padding: 0; }
  .book__stage { display: grid; align-content: center; gap: 1rem; padding-block: var(--section); }
  /* Pinned: the section is tall and the stage holds the screen while it scrolls past */
  :global(.js) .book:not(.is-static) { height: 405svh; }
  :global(.js) .book:not(.is-static) .book__stage { position: sticky; top: 0; height: 100svh; padding-block: 0; overflow: hidden; }
  .book__grid { display: grid; gap: 2rem 3rem; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); align-items: center; }
  .book__title { font-size: var(--step-3); }
  .book__lead { display: block; }
  .book__line { font: 500 var(--step-1)/1.3 var(--font-ui); letter-spacing: -0.015em; max-width: 30ch; }
  .facts { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.4rem; }
  .facts li { border-top: 1px solid var(--line-strong); padding-top: 0.4rem; }
  .book__note { text-align: center; }

  /* Each swap stacks its variants in one cell, so it keeps the height of the longest */
  .swap { display: grid; }
  .swap__item {
    grid-area: 1 / 1; opacity: 0; visibility: hidden; transform: translateY(0.35em);
    transition: opacity var(--dur-slow) var(--ease-out), transform var(--dur-slow) var(--ease-out), visibility 0s var(--dur-slow);
  }
  .swap__item.is-past { transform: translateY(-0.35em); }
  .swap__item.is-on { opacity: 1; visibility: visible; transform: none; transition-delay: 0s; }
  span.swap { display: grid; }
  .book__title .swap__item { display: block; }

  @media (max-width: 900px) {
    .book__grid { grid-template-columns: 1fr; gap: 1.25rem; }
    .book__title { font-size: clamp(2rem, 1.4rem + 3vw, 3rem); }
    .book__line { font-size: 1.0625rem; }
    .facts { font-size: 0.75rem; }
  }
  @media (max-width: 900px) and (max-height: 760px) { .book__words .facts { display: none; } }

  /* ---- The scene ---- */
  .book__scene {
    --bw: min(34svh, 21vw); --bh: calc(var(--bw) * 1.5);
    position: relative; height: calc(var(--bh) * 1.25);
  }
  @media (max-width: 900px) { .book__scene { --bw: min(24svh, 40vw); } }

  /* A form: placed and faded as a whole, with its own perspective so fading it doesn't
     flatten the model. Defaults are the closing row (see the script). */
  .form {
    position: absolute; inset: 0; display: grid; place-items: center; perspective: calc(var(--bw) * 7);
    transform: translate(var(--fx, 0px), var(--fy, 0px)) scale(var(--fs, 0.5)); opacity: var(--fo, 1);
  }
  .form--book { --fx: calc(var(--bw) * -0.765); }
  .form--poetry { --fx: calc(var(--bw) * -0.235); --fy: calc(var(--bw) * 0.02); }
  .form--script { --fx: calc(var(--bw) * 0.305); --fy: calc(var(--bw) * 0.039); }
  .form--ebook { --fx: calc(var(--bw) * 0.815); --fy: calc(var(--bw) * 0.1); }
  .form__shadow {
    position: absolute; left: 50%; top: 50%; width: calc(var(--w) * 1.05); height: calc(var(--h) * 0.6);
    transform: translate(-50%, -36%) scaleX(var(--spread, 1)); border-radius: 50%;
    background: radial-gradient(closest-side, rgba(20, 16, 10, 0.32), transparent);
    filter: blur(18px);
  }
  .form--book { --w: var(--bw); --h: var(--bh); --t: calc(var(--bw) * 0.12); }
  .form--poetry { --w: calc(var(--bw) * 0.92); --h: calc(var(--bw) * 1.42); --t: calc(var(--bw) * 0.03); }
  .form--script { --w: calc(var(--bw) * 1.04); --h: calc(var(--w) * 11 / 8.5); --t: calc(var(--bw) * 0.07); }
  .form--ebook { --w: calc(var(--bw) * 0.8); --h: calc(var(--bw) * 1.1); --t: calc(var(--bw) * 0.05); }

  .model {
    position: relative; width: var(--w); height: var(--h); transform-style: preserve-3d;
    transform: translateX(var(--shift, 0px)) rotateX(var(--rx, 8deg)) rotateY(var(--ry, 16deg)) rotateZ(var(--rz, 0deg));
  }

  /* A bound thing: back, spine, three page edges, the top page, and a cover on the spine */
  .tm { position: absolute; left: 0; top: 0; width: var(--w); height: var(--h); transform-style: preserve-3d; }
  .tm--back { transform: translateZ(calc(var(--t) / -2)); border-radius: 0 3px 3px 0; box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.15); }
  .tm--spine {
    width: var(--t); transform-origin: left center; transform: translateZ(calc(var(--t) / -2)) rotateY(-90deg);
    backface-visibility: hidden;
  }
  .tm--edge { backface-visibility: hidden; }
  .tm--fore { width: var(--t); transform-origin: left center; transform: translateX(calc(var(--w) - 2px)) translateZ(calc(var(--t) / 2)) rotateY(90deg); background: repeating-linear-gradient(90deg, #f3eee3 0 1px, #ddd5c4 1px 2px); }
  .tm--head { height: var(--t); transform-origin: center top; transform: translateZ(calc(var(--t) / -2)) rotateX(90deg); background: repeating-linear-gradient(0deg, #f3eee3 0 1px, #ddd5c4 1px 2px); }
  .tm--tail { top: var(--h); height: var(--t); transform-origin: center top; transform: translateZ(calc(var(--t) / 2)) rotateX(-90deg); background: repeating-linear-gradient(0deg, #f3eee3 0 1px, #ddd5c4 1px 2px); }
  .tm--top { transform: translateZ(calc(var(--t) / 2 - 1px)); }
  .tm--cover { transform-origin: left center; transform: translateZ(calc(var(--t) / 2 + 2px)) rotateY(var(--cov, 0deg)); }
  .face { position: absolute; inset: 0; backface-visibility: hidden; }
  .face--back { transform: rotateY(180deg); }

  /* Pages are paper in every theme: it's a printed book */
  .page {
    background: #fffdf8; color: #1f1c18; overflow: hidden;
    padding: 13% 12% 14%; font: 400 calc(var(--bw) * 0.037)/1.45 var(--font-read);
    box-shadow: inset 0 0 0 1px rgba(40, 32, 20, 0.08);
  }
  .page--recto { background: linear-gradient(90deg, #ece6d9 0%, #fffdf8 9%); }
  .page--verso { background: linear-gradient(270deg, #ece6d9 0%, #fffdf8 9%); }

  /* The book */
  .form--book .tm--back { background: #34502f; }
  .form--book .tm--spine {
    background: linear-gradient(90deg, #2b4227, #3a5734 45%, #2f4a2b);
    display: flex; flex-direction: column; align-items: center; justify-content: space-between; padding-block: 10%;
    color: #efe8da; font: 400 calc(var(--bw) * 0.045)/1 var(--font-read); letter-spacing: 0.06em; text-transform: uppercase;
  }
  .tm--spine span { writing-mode: vertical-rl; white-space: nowrap; }
  .tm__spine-by { font-size: 0.8em; opacity: 0.8; }
  .page__head { font-size: 0.72em; letter-spacing: 0.14em; text-transform: uppercase; text-align: center; color: #6b645a; margin-bottom: 1.6em; }
  .page__chap { font-size: 0.8em; letter-spacing: 0.16em; text-transform: uppercase; text-align: center; color: #6b645a; margin-top: 18%; }
  .page__title { font-size: 1.9em; line-height: 1.1; text-align: center; font-style: italic; margin: 0.4em 0 1.6em; }
  .page__text { text-align: justify; hyphens: auto; -webkit-hyphens: auto; }
  .page__text + .page__text { text-indent: 1.4em; }
  .page__drop { float: left; font-size: 3.3em; line-height: 0.86; padding: 0.06em 0.08em 0 0; }
  .page__folio { position: absolute; bottom: 6%; font-size: 0.75em; color: #6b645a; }
  .page--recto .page__folio { right: 12%; }
  .page--verso .page__folio { left: 12%; }
  .cover {
    background:
      radial-gradient(120% 70% at 70% 15%, rgba(255, 244, 222, 0.16), transparent 60%),
      linear-gradient(160deg, #46653f, #3f5a3a 45%, #2f472b);
    color: #f2eee6; border-radius: 0 3px 3px 0;
    display: grid; align-content: space-between; padding: 16% 12% 12%;
    box-shadow: inset 4px 0 6px -3px rgba(0, 0, 0, 0.35);
  }
  .cover__title { font: 400 calc(var(--bw) * 0.13)/1 var(--font-read); letter-spacing: -0.02em; }
  .cover__by { font: 400 calc(var(--bw) * 0.045)/1 var(--font-read); letter-spacing: 0.16em; text-transform: uppercase; }
  .cover__tag { position: absolute; left: 12%; right: 12%; top: 52%; color: rgba(242, 238, 230, 0.75); font-size: calc(var(--bw) * 0.04); text-align: center; }

  /* The chapbook: kraft card, a thin fold for a spine, short poems with room round them */
  .form--poetry .tm--back { background: #bea77f; }
  .form--poetry .tm--spine { background: linear-gradient(90deg, #a8916a, #c4ae88 50%, #ad966f); }
  .form--poetry .cover {
    background:
      radial-gradient(90% 60% at 30% 20%, rgba(255, 250, 238, 0.22), transparent 70%),
      repeating-linear-gradient(17deg, rgba(90, 70, 40, 0.05) 0 1px, transparent 1px 4px),
      #cdb68e;
    color: #2a241b; align-content: start; gap: 0.8em; padding: 22% 14% 12%;
    box-shadow: inset 3px 0 4px -2px rgba(0, 0, 0, 0.25);
  }
  .form--poetry .cover__title { font-size: calc(var(--bw) * 0.11); font-style: italic; }
  .cover__kind { font: 400 calc(var(--bw) * 0.04)/1 var(--font-read); letter-spacing: 0.2em; text-transform: uppercase; color: #5b4e3a; }
  .form--poetry .cover__by { position: absolute; left: 14%; bottom: 10%; font-size: calc(var(--bw) * 0.038); color: #3b3226; }
  .poem { padding: 20% 16% 14%; font-size: calc(var(--bw) * 0.042); line-height: 1.5; }
  .poem__title { font-style: italic; font-size: 1.25em; margin-bottom: 1.4em; }
  .poem__stanza { margin-bottom: 1.1em; }
  .poem__stanza span { display: block; }
  .poem__stanza span:nth-child(even) { padding-left: 1.2em; }
  .poem__folio { position: absolute; left: 0; right: 0; bottom: 7%; text-align: center; font-size: 0.7em; color: #6b645a; }

  /* The screenplay: Courier 12 on a letter page, where 1 in = 6em (10 characters to the inch) */
  .form--script .tm--back { background: #d6d0c2; border-radius: 0; }
  .form--script .tm--spine { background: repeating-linear-gradient(90deg, #f3eee3 0 1px, #ddd5c4 1px 2px); }
  .sp {
    background: #fdfcf9; color: #1d1b18; overflow: hidden;
    font: 400 calc(var(--w) / 51)/1 var(--font-type);
    box-shadow: inset 0 0 0 1px rgba(40, 32, 20, 0.08);
  }
  .sp--page { padding: 6em 6em 6em 9em; }
  .sp--page p { margin: 0 0 1em; }
  .sp__scene { text-transform: uppercase; }
  .sp__character { margin: 0 0 0 13.2em !important; }
  .sp__parenthetical { margin: 0 0 0 9.6em !important; max-width: 12em; }
  .sp__dialogue { margin-left: 6em !important; max-width: 21em; }
  .sp__hole, .sp__brad { position: absolute; left: 3em; width: 1.6em; height: 1.6em; margin: -0.8em 0 0 -0.8em; border-radius: 50%; }
  .sp__hole { background: radial-gradient(circle, #3a352d 0 40%, #6d665a 41% 55%, transparent 60%); }
  .sp__brad {
    width: 2.4em; height: 2.4em; margin: -1.2em 0 0 -1.2em;
    background: radial-gradient(circle at 38% 34%, #f6dfa0, #c99b45 45%, #8a6527 80%);
    box-shadow: 0 1px 2px rgba(60, 40, 10, 0.5);
  }
  .sp > :nth-child(1) { top: 11.4%; }
  .sp > :nth-child(2) { top: 50%; }
  .sp > :nth-child(3) { top: 88.6%; }
  .sp__titleblock { position: absolute; left: 0; right: 0; top: 33%; text-align: center; }
  .sp__titleblock p:first-child { text-decoration: underline; margin-bottom: 4em; }
  .sp__titleblock p + p { margin-top: 1em; }
  .sp__contact { position: absolute; left: 9em; bottom: 6em; display: grid; gap: 0; }
  .sp--behind { background: #f6f4ef; }

  /* The e-reader: a dark slab with an e-ink screen */
  .dv { position: absolute; left: 0; top: 0; width: var(--w); height: var(--h); background: #1f1e1c; backface-visibility: hidden; }
  .dv--back { transform: translateZ(calc(var(--t) / -2)) rotateY(180deg); border-radius: calc(var(--w) * 0.07); background: #2a2926; }
  .dv--front { transform: translateZ(calc(var(--t) / 2)); border-radius: calc(var(--w) * 0.07); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06); }
  .dv--side { width: var(--t); top: calc(var(--w) * 0.07); height: calc(var(--h) - var(--w) * 0.14); transform-origin: left center; background: linear-gradient(90deg, #191816, #2c2b28, #191816); }
  .dv--l { transform: translateZ(calc(var(--t) / 2)) rotateY(-90deg); }
  .dv--r { transform: translateX(var(--w)) translateZ(calc(var(--t) / -2)) rotateY(90deg); }
  .dv--end { height: var(--t); left: calc(var(--w) * 0.07); width: calc(var(--w) * 0.86); transform-origin: center top; background: linear-gradient(0deg, #191816, #2c2b28, #191816); }
  .dv--t { transform: translateZ(calc(var(--t) / -2)) rotateX(90deg); }
  .dv--b { top: var(--h); transform: translateZ(calc(var(--t) / 2)) rotateX(-90deg); }
  .dv__screen { position: absolute; inset: 6.5% 6.5% 9.5%; background: #e8e6de; border-radius: 2px; overflow: hidden; box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.35); }
  .scr { position: absolute; inset: 0; }
  .scr--read { bottom: 9%; overflow: hidden; padding: 12% 10% 0; color: #1f1d1a; font: 400 calc(var(--bw) * 0.034)/1.45 var(--font-read); }
  .scr__chap { font-size: 0.75em; letter-spacing: 0.16em; text-transform: uppercase; text-align: center; color: #5f5a52; margin-top: 6%; }
  .scr__title { font-size: 1.6em; line-height: 1.1; font-style: italic; text-align: center; margin: 0.3em 0 1.2em; }
  .scr__text { text-align: left; }
  .scr__text + .scr__text { text-indent: 1.4em; }
  .scr__foot { position: absolute; left: 10%; right: 10%; bottom: 3.5%; display: flex; justify-content: space-between; font: 400 calc(var(--bw) * 0.021)/1 var(--font-ui); color: #6a655c; opacity: var(--wake, 0); }
  .scr--sleep {
    opacity: calc(1 - var(--wake, 0));
    background: linear-gradient(160deg, #6d7a66, #4f5c4a 50%, #3c4738); filter: grayscale(0.7);
    color: #f1efe8; display: grid; align-content: space-between; padding: 16% 12% 12%;
  }
  .scr--sleep .cover__title { font-size: calc(var(--bw) * 0.1); }
  .scr--sleep .cover__by { font-size: calc(var(--bw) * 0.036); }
</style>

<script>
  import { add, ease, lerp, seg, reduceMotion } from '../scripts/frame'

  // The scroll, in screens: 0 as the section's top comes up from the bottom of the screen,
  // about 1 when it pins, LEN when it lets go. The book turns while the section arrives
  // and opens once it's pinned; then each swap hands over to the next form, which opens.
  const LEN = 4.05
  const BOOK = { turn: [0.2, 0.9], open: [0.9, 1.2] }
  const SWAPS = [1.35, 2.05, 2.75]
  const GATHER = [3.45, 3.85]
  const OUT = 0.25, IN: [number, number] = [0.1, 0.35], OPEN: [number, number] = [0.35, 0.6]
  // The closing row: each form's centre (in book widths, before scaling), drop, tilt and height.
  const ROW = { x: [-1.53, -0.47, 0.61, 1.63], h: [1.5, 1.42, 1.345, 1.1], rz: [-2, 1.5, -1, 2.5] }

  document.querySelectorAll<HTMLElement>('.book').forEach((section) => {
    const scene = section.querySelector<HTMLElement>('.book__scene')!
    const forms = [...scene.querySelectorAll<HTMLElement>('.form')]
    const models = forms.map((f) => f.querySelector<HTMLElement>('.model')!)
    const swaps = [...section.querySelectorAll<HTMLElement>('.swap')].map((s) => [...s.children] as HTMLElement[])
    if (reduceMotion) { section.classList.add('is-static'); return }
    let shown = -1

    add(section, {
      tick() {
        const r = section.getBoundingClientRect(), vh = window.innerHeight
        const S = ((vh - r.top) / r.height) * LEN
        const bw = models[0].offsetWidth
        const s = Math.min(0.55, scene.offsetWidth / (4.4 * bw))

        forms.forEach((form, k) => {
          const m = models[k], w = m.offsetWidth
          const from = k ? SWAPS[k - 1] : 0
          const arrive = k ? ease(seg(S, from + IN[0], from + IN[1])) : ease(seg(S, BOOK.turn[0], BOOK.turn[1]))
          const leave = k < SWAPS.length ? ease(seg(S, SWAPS[k], SWAPS[k] + OUT)) : 0
          const open = k ? ease(seg(S, from + OPEN[0], from + OPEN[1])) : ease(seg(S, BOOK.open[0], BOOK.open[1]))

          // Where the swaps put it: turning in from the right, out to the left
          let fx = (k ? lerp(0.55, 0, arrive) : 0) * bw - 0.55 * bw * leave
          let ry = (k ? lerp(60, 0, arrive) : lerp(52, 0, arrive)) - 60 * leave
          let rx = k ? lerp(10, 4, open) : lerp(14, 4, Math.max(arrive * 0.5, open))
          let rz = k ? 0 : lerp(-5, 0, arrive)
          let fo = (k ? seg(arrive, 0, 0.6) : 1) * (1 - seg(leave, 0.35, 1))
          // ...and where the row puts it, closed again. The ebook, still on screen, steps
          // aside first; the forms that left come back one by one, closed, rising into place.
          const g = k === 3 ? ease(seg(S, GATHER[0], GATHER[0] + 0.25))
            : ease(seg(S, GATHER[0] + 0.08 + k * 0.05, GATHER[1] - (2 - k) * 0.05))
          const back = k < 3 && S > GATHER[0]
          const slotY = ((ROW.h[0] - ROW.h[k]) / 2) * bw * s
          let fy = back ? slotY + 0.25 * bw : 0
          if (back) { fx = ROW.x[k] * bw * s; ry = 16; rx = 8; rz = ROW.rz[k]; fo = 0 }
          fx = lerp(fx, ROW.x[k] * bw * s, g); fy = lerp(fy, slotY, g)
          ry = lerp(ry, 16, g); rx = lerp(rx, 8, g); rz = lerp(rz, ROW.rz[k], g)
          fo = lerp(fo, 1, g)

          form.style.setProperty('--fx', `${fx.toFixed(1)}px`)
          form.style.setProperty('--fy', `${fy.toFixed(1)}px`)
          form.style.setProperty('--fs', (back ? s : lerp(1, s, g)).toFixed(3))
          form.style.setProperty('--fo', fo.toFixed(3))
          m.style.setProperty('--ry', `${ry.toFixed(2)}deg`)
          m.style.setProperty('--rx', `${rx.toFixed(2)}deg`)
          m.style.setProperty('--rz', `${rz.toFixed(2)}deg`)

          if (k === 3) { m.style.setProperty('--wake', (open * (1 - g)).toFixed(3)); return }
          const cov = back ? 0 : open
          m.style.setProperty('--shift', `${((cov * w) / 2).toFixed(1)}px`)
          m.style.setProperty('--cov', `${(-178 * cov).toFixed(2)}deg`)
          form.style.setProperty('--spread', lerp(1, 1.9, cov).toFixed(3))
        })

        // The words change halfway through each swap, and once the row starts to gather.
        const at = [...SWAPS.map((x) => x + 0.17), GATHER[0] + 0.1]
        const i = at.filter((x) => S >= x).length
        if (i !== shown) {
          shown = i
          swaps.forEach((items) => items.forEach((el, j) => {
            el.classList.toggle('is-on', j === i)
            el.classList.toggle('is-past', j < i)
          }))
        }
        return false
      },
    })
  })
</script>
